# Copy to .env and fill in what you have. EVERYTHING IS OPTIONAL —
# the system works with zero keys (yfinance polling, DELAYED ~15min quotes).

# Live prices, preferred: free key from https://finnhub.io
FINNHUB_API_KEY=

# Live prices fallback + paper trading bridge: https://alpaca.markets
# PAPER keys only — the broker bridge refuses anything else.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Telegram alerts: create a bot with @BotFather, get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Defaults for the dashboard sidebar
ACCOUNT_SIZE=100000
RISK_PCT=1.0

# Override the SQLite location if you want (default: ./trading.db)
# TRADING_DB=/path/to/trading.db
